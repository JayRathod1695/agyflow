{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DroppedPayload",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "reason_code": { "type": "string" },
          "detail": { "type": "string" }
        },
        "required": ["id", "reason_code", "detail"],
        "additionalProperties": false
      }
    },
    "total_in": { "type": "integer", "minimum": 0 },
    "total_dropped": { "type": "integer", "minimum": 0 },
    "drop_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "required": ["items", "total_in", "total_dropped", "drop_ratio"],
  "additionalProperties": false
}
