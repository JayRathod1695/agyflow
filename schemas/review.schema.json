{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewPayload",
  "type": "object",
  "properties": {
    "verdict": { "enum": ["approve", "changes_requested"] },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": { "enum": ["HIGH", "MED", "LOW"] },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "quote": { "type": "string", "maxLength": 200 },
          "problem": { "type": "string", "maxLength": 240 },
          "suggestion": { "type": "string", "maxLength": 240 }
        },
        "required": ["severity", "file", "line", "quote", "problem", "suggestion"],
        "additionalProperties": false
      },
      "maxItems": 10
    },
    "residual_risks": {
      "type": "array",
      "items": { "type": "string", "maxLength": 200 },
      "maxItems": 6
    }
  },
  "required": ["verdict", "issues", "residual_risks"],
  "additionalProperties": false
}
